# Supabase — Web Push 구독 정보(push_subscriptions) 저장/조회용
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# DART Open API — scripts/fetch-facts.mjs 전용 (GitHub Actions secret으로만 설정).
# VITE_ 접두사를 붙이면 안 됨 — 붙이면 클라이언트 번들에 그대로 노출됨.
DART_API_KEY="opendart.fss.or.kr 에서 발급받은 키"
